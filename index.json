const express = require('express');const axios = require('axios');const app = express();app.use(express.json());app.all('*', async (req, res) => {    const targetUrl = 'https://api.thestrangerx.com' + req.originalUrl;        try {        const response = await axios({            method: req.method,            url: targetUrl,            headers: { ...req.headers, host: 'api.thestrangerx.com' },            data: req.body,            validateStatus: () => true        });        let body = response.data;        // ТВОЙ СКРИПТ        let target = body.entitlements || body;        if (typeof target === 'object' && target !== null) {            for (let key in target) {                let lowerKey = key.toLowerCase();                                if (target[key] === false) {                    if (                        lowerKey.includes("app") ||                         lowerKey.includes("unlock") ||                         lowerKey.includes("borrowed") ||                         lowerKey.includes("nexus") ||                         lowerKey.includes("premium") ||                         lowerKey.includes("sub")                    ) {                        target[key] = true;                    }                }                                if (target[key] === null && lowerKey.includes("source")) {                    target[key] = "STORE";                }            }        }        res.status(response.status).json(body);    } catch (error) {        res.status(500).json({ error: "Proxy Error" });    }});const PORT = process.env.PORT || 3000;app.listen(PORT, () => console.log('Proxy running on port ' + PORT));